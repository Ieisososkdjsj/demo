          <ScalarProperty Name="Категория_товара" ColumnName="Категория товара" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Корзина">
      <EntityTypeMapping TypeName="demoExamModel.Корзина">
        <MappingFragment StoreEntitySet="Корзина">
          <ScalarProperty Name="id_корзины" ColumnName="id_корзины" />
          <ScalarProperty Name="id_заказа" ColumnName="id_заказа" />
          <ScalarProperty Name="id_товара" ColumnName="id_товара" />
          <ScalarProperty Name="Количество" ColumnName="Количество" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Наименования_товаров">
      <EntityTypeMapping TypeName="demoExamModel.Наименования_товаров">
