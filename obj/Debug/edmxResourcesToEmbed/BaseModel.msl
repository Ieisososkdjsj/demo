          <ScalarProperty Name="id_поставщика" ColumnName="id_поставщика" />
          <ScalarProperty Name="Поставщик" ColumnName="Поставщик" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Производители">
      <EntityTypeMapping TypeName="demoExamModel.Производители">
        <MappingFragment StoreEntitySet="Производители">
          <ScalarProperty Name="id_производителя" ColumnName="id_производителя" />
          <ScalarProperty Name="Производитель" ColumnName="Производитель" />
