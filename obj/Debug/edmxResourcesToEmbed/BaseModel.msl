          <ScalarProperty Name="Наименование_товара" ColumnName="Наименование товара" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Пользователи">
      <EntityTypeMapping TypeName="demoExamModel.Пользователи">
        <MappingFragment StoreEntitySet="Пользователи">
          <ScalarProperty Name="id_пользователя" ColumnName="id_пользователя" />
          <ScalarProperty Name="id_роль_сотрудника" ColumnName="id_роль_сотрудника" />
          <ScalarProperty Name="Фамилия" ColumnName="Фамилия" />
