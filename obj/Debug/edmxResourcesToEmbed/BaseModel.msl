<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="Хранилище demoExamModelContainer" CdmEntityContainer="demo_examEntities">
    <EntitySetMapping Name="sysdiagrams">
      <EntityTypeMapping TypeName="demoExamModel.sysdiagrams">
        <MappingFragment StoreEntitySet="sysdiagrams">
          <ScalarProperty Name="name" ColumnName="name" />
          <ScalarProperty Name="principal_id" ColumnName="principal_id" />
          <ScalarProperty Name="diagram_id" ColumnName="diagram_id" />
          <ScalarProperty Name="version" ColumnName="version" />
          <ScalarProperty Name="definition" ColumnName="definition" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Заказы">
      <EntityTypeMapping TypeName="demoExamModel.Заказы">
        <MappingFragment StoreEntitySet="Заказы">
          <ScalarProperty Name="id_заказа" ColumnName="id_заказа" />
          <ScalarProperty Name="Номер_заказа" ColumnName="Номер заказа" />
          <ScalarProperty Name="Дата_заказа" ColumnName="Дата заказа" />
          <ScalarProperty Name="Дата_доставки" ColumnName="Дата доставки" />
          <ScalarProperty Name="id_пвз" ColumnName="id_пвз" />
          <ScalarProperty Name="id_пользователя" ColumnName="id_пользователя" />
          <ScalarProperty Name="Код_для_получения" ColumnName="Код для получения" />
          <ScalarProperty Name="id_статуса_заказа" ColumnName="id_статуса_заказа" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Категории_товаров">
      <EntityTypeMapping TypeName="demoExamModel.Категории_товаров">
