<Page x:Class="demoExam.ТоварыEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:demoExam"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ТоварыEditPage"
      Loaded="Page_Loaded">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка с кнопкой Назад -->
        <Grid Grid.Row="0" Background="#F4E8D3">
            <Button Content="← Назад" Width="90" Height="34" HorizontalAlignment="Right" Margin="0,0,12,0" Background="Transparent" BorderBrush="#999" Click="BtnBack_Click"/>
            <TextBlock x:Name="TitleBlock" Text="Добавление товара" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="16,18,126,18"/>
        </Grid>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" Margin="20">
            <StackPanel MinWidth="700" HorizontalAlignment="Center">

                <TextBlock Text="Фото:" Margin="0,8,0,4"></TextBlock>
                <TextBox x:Name="PhotoBox" Height="34"></TextBox>

                <TextBlock Text="Наименование:" Margin="0,8,0,4"/>
                <ComboBox x:Name="NameCombo" Height="34" DisplayMemberPath="Наименование_товара" SelectedValuePath="id_наименования_товара"/>

                <TextBlock Text="Категория:" Margin="0,8,0,4"/>
                <ComboBox x:Name="CategoryCombo" Height="34" DisplayMemberPath="Категория_товара" SelectedValuePath="id_категории_товара"/>

                <TextBlock Text="Производитель:" Margin="0,8,0,4"/>
                <ComboBox x:Name="ManufacturerCombo" Height="34" DisplayMemberPath="Производитель"   SelectedValuePath="id_производителя"/>

                <TextBlock Text="Поставщик:" Margin="0,8,0,4"/>
                <ComboBox x:Name="SupplierCombo" Height="34" DisplayMemberPath="Поставщик" SelectedValuePath="id_поставщика"/>

                <TextBlock Text="Цена:" Margin="0,8,0,4"/>
                <TextBox x:Name="PriceBox" Height="34" Padding="8,6" BorderBrush="#CCCCCC" Text="0"/>

                <TextBlock Text="Скидка (%):" Margin="0,8,0,4"/>
                <TextBox x:Name="DiscountBox" Height="34" Padding="8,6" BorderBrush="#CCCCCC" Text="0"/>

                <TextBlock Text="Кол-во на складе:" Margin="0,8,0,4"/>
                <TextBox x:Name="StockBox" Height="34" Padding="8,6" BorderBrush="#CCCCCC" Text="0"/>

                <TextBlock Text="Единица измерения:" Margin="0,8,0,4"/>
                <TextBox x:Name="UnitBox" Height="34" Padding="8,6" BorderBrush="#CCCCCC"/>

                <TextBlock Text="Описание:" Margin="0,8,0,4"/>
                <TextBox x:Name="DescBox" Height="80" Padding="8,6" TextWrapping="Wrap" AcceptsReturn="True" BorderBrush="#CCCCCC"/>

                <Button Content="Сохранить" Height="42" Margin="0,20,0,0" Background="#67BA80" Foreground="White" FontSize="14" BorderThickness="0" Click="BtnSave_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
